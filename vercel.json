{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "installCommand": "npm ci",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/env-config.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
